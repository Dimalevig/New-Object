+				return;
+			if (steamid != "")
+				codes.Set(steamid, code);
+		}
+	}
+
+	static string Get(string steamid) {
+		if (!codes || !codes.Contains(steamid))
+			return "";
+		return codes.Get(steamid);
+	}
+}
