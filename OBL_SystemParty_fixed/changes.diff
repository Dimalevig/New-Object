@@ -1,321 +0,0 @@
-// Alliance pending request entry
-class OBLAlliancePendingRequest {
-	string requesterShortname;  // group that sent the request
-	string targetShortname;     // group that should accept
-	int    timestamp;
-
-	void OBLAlliancePendingRequest(string requester, string target) {
-		requesterShortname = requester;
-		targetShortname    = target;
-		timestamp          = GetGame().GetTime();
-	}
-}
-
-// Server-side alliance manager, injected into OBLPartyManager via modded class (see groupmanager.c)
-class OBLAllianceManager {
-
-	const int REQUEST_TIMEOUT_MS = 120 * 1000; // 2 min
-
-	ref array<ref OBLAlliancePendingRequest> pendingRequests = new array<ref OBLAlliancePendingRequest>();
-
-	// ---- Utilities ----
-
-	OBLAlliancePendingRequest FindPending(string requester, string target) {
-		foreach (OBLAlliancePendingRequest req : pendingRequests) {
-			if (req.requesterShortname == requester && req.targetShortname == target)
-				return req;
-		}
-		return null;
-	}
-
-	void PurgeExpiredRequests() {
-		int now = GetGame().GetTime();
-		for (int i = pendingRequests.Count() - 1; i >= 0; i--) {
-			OBLAlliancePendingRequest req = pendingRequests.Get(i);
-			if (now - req.timestamp > REQUEST_TIMEOUT_MS) {
-				pendingRequests.Remove(i);
-			}
-		}
-	}
-
-	// Send the list of incoming pending requests (requester shortnames) to every online member of targetGrp
-	void SendPendingSyncToGroup(OBLParty targetGrp) {
-		if (!targetGrp)
-			return;
-		PurgeExpiredRequests();
-		ref TStringArray requesters = new TStringArray();
-		foreach (OBLAlliancePendingRequest req : pendingRequests) {
-			if (req.targetShortname == targetGrp.shortname)
-				requesters.Insert(req.requesterShortname);
-		}
-		foreach (OBLPartyMember member : targetGrp.members) {
-			if (!member)
-				continue;
-			PlayerBase pb = OBLParty.GetPlayerBySteamid(member.steamid);
-			if (!pb || !pb.GetIdentity())
-				continue;
-			PlayerIdentity ident = pb.GetIdentity();
-			ScriptRPC rpc = new ScriptRPC();
-			rpc.Write(OBLPartyRPCs.ALLIANCE_PENDING_SYNC);
-			rpc.Write(requesters.Count());
-			foreach (string r : requesters) {
-				rpc.Write(r);
-			}
-			rpc.Send(pb, OBLPartyRPCs.GROUP_RPC, true, ident);
-		}
-	}
-
-	// ---- Sync helpers ----
-
-	void SyncAllianceToGroup(OBLParty grp) {
-		// For each online member of grp: send ALLIANCE_SYNC (tag list) + ALLIANCE_MEMBER_ADD for all allied player markers
-		foreach (OBLPartyMember member : grp.members) {
-			if (!member)
-				continue;
-			PlayerBase pb = OBLParty.GetPlayerBySteamid(member.steamid);
-			if (!pb || !pb.GetIdentity())
-				continue;
-			PlayerIdentity ident = pb.GetIdentity();
-
-			// 1. Send ALLIANCE_SYNC (tag list)
-			ScriptRPC syncRpc = new ScriptRPC();
-			syncRpc.Write(OBLPartyRPCs.ALLIANCE_SYNC);
-			syncRpc.Write(grp.allianceGroups.Count());
-			foreach (string tag : grp.allianceGroups) {
-				syncRpc.Write(tag);
-			}
-			syncRpc.Send(pb, OBLPartyRPCs.GROUP_RPC, true, ident);
-
-			// 2. Send ALLIANCE_MEMBER_ADD for each online member of each allied group
-			OBLPartyManager mgr = OBLPartyManager.Get();
-			if (!mgr)
-				continue;
-			foreach (string alliedTag : grp.allianceGroups) {
-				OBLParty alliedGrp = mgr.GetGroupByShortName(alliedTag);
-				if (!alliedGrp)
-					continue;
-				foreach (OBLPartyMember alliedMember : alliedGrp.members) {
-					if (!alliedMember || !alliedMember.online)
-						continue;
-					ScriptRPC addRpc = new ScriptRPC();
-					addRpc.Write(OBLPartyRPCs.ALLIANCE_MEMBER_ADD);
-					alliedMember.WriteToCtx(addRpc);
-					addRpc.Send(pb, OBLPartyRPCs.GROUP_RPC, true, ident);
-				}
-			}
-		}
-	}
-
-	// Remove allied member markers from a group when alliance ends
-	void SyncRemoveAlliedMembersFromGroup(OBLParty grp, OBLParty removedAlliedGrp) {
-		foreach (OBLPartyMember member : grp.members) {
-			if (!member)
-				continue;
-			PlayerBase pb = OBLParty.GetPlayerBySteamid(member.steamid);
-			if (!pb || !pb.GetIdentity())
-				continue;
-			PlayerIdentity ident = pb.GetIdentity();
-			foreach (OBLPartyMember alliedMember : removedAlliedGrp.members) {
-				if (!alliedMember)
-					continue;
-				ScriptRPC removeRpc = new ScriptRPC();
-				removeRpc.Write(OBLPartyRPCs.ALLIANCE_MEMBER_REMOVE);
-				removeRpc.Write(alliedMember.uid);
-				removeRpc.Send(pb, OBLPartyRPCs.GROUP_RPC, true, ident);
-			}
-		}
-	}
-
-	// ---- RPC handlers ----
-
-	bool AlliancesEnabled(PlayerIdentity sender, OBLPartyManager mgr) {
-		if (!OBLPartyMainConfig.Get().enableAlliances) {
-			if (sender && mgr)
-				mgr.SendErrorNotification(sender, "Систему альянсів вимкнено на цьому сервері.");
-			return false;
-		}
-		return true;
-	}
-
-	// Leader of requesterGrp sends ALLIANCE_REQUEST targeting targetShortname
-	void HandleRequest(PlayerIdentity sender, OBLParty requesterGrp, string targetShortname, OBLPartyManager mgr) {
-		if (!AlliancesEnabled(sender, mgr))
-			return;
-		if (!IsLeader(sender, requesterGrp)) {
-			mgr.SendErrorNotification(sender, "Тільки лідер групи може надсилати запит на альянс!");
-			return;
-		}
-
-		OBLParty targetGrp = mgr.GetGroupByShortName(targetShortname);
-		if (!targetGrp) {
-			mgr.SendErrorNotification(sender, "Групу [" + targetShortname + "] не знайдено!");
-			return;
-		}
-
-		if (requesterGrp.shortname == targetShortname) {
-			mgr.SendErrorNotification(sender, "Не можна укласти альянс із власною групою.");
-			return;
-		}
-
-		if (requesterGrp.IsAllied(targetShortname)) {
-			mgr.SendErrorNotification(sender, "Ваша група вже в альянсі з [" + targetShortname + "]!");
-			return;
-		}
-
-		// Avoid duplicate requests
-		PurgeExpiredRequests();
-		if (FindPending(requesterGrp.shortname, targetShortname)) {
-			mgr.SendErrorNotification(sender, "Запит вже надіслано, чекайте відповіді.");
-			return;
-		}
-
-		pendingRequests.Insert(new OBLAlliancePendingRequest(requesterGrp.shortname, targetShortname));
-
-		// Push updated pending list to the target group so it appears in their Alliance UI
-		SendPendingSyncToGroup(targetGrp);
-
-		// Notify target group leader
-		NotifyGroupLeader(targetGrp, "Група [" + requesterGrp.shortname + "] пропонує альянс! Прийміть через меню Alliance.");
-		mgr.SendInfoNotification(sender, "Запит на альянс надіслано групі [" + targetShortname + "].");
-		OBLLogger.Debug("Alliance Request: " + requesterGrp.shortname + " -> " + targetShortname);
-	}
-
-	// Leader of accepterGrp accepts request from requesterShortname
-	void HandleAccept(PlayerIdentity sender, OBLParty accepterGrp, string requesterShortname, OBLPartyManager mgr) {
-		if (!AlliancesEnabled(sender, mgr))
-			return;
-		if (!IsLeader(sender, accepterGrp)) {
-			mgr.SendErrorNotification(sender, "Тільки лідер групи може прийняти запит на альянс!");
-			return;
-		}
-
-		PurgeExpiredRequests();
-		OBLAlliancePendingRequest pending = FindPending(requesterShortname, accepterGrp.shortname);
-		if (!pending) {
-			mgr.SendErrorNotification(sender, "Запит на альянс від [" + requesterShortname + "] не знайдено або прострочено.");
-			return;
-		}
-
-		OBLParty requesterGrp = mgr.GetGroupByShortName(requesterShortname);
-		if (!requesterGrp) {
-			mgr.SendErrorNotification(sender, "Групу [" + requesterShortname + "] більше не існує.");
-			pendingRequests.RemoveItem(pending);
-			return;
-		}
-
-		// Establish alliance both ways
-		if (accepterGrp.allianceGroups.Find(requesterShortname) == -1)
-			accepterGrp.allianceGroups.Insert(requesterShortname);
-		if (requesterGrp.allianceGroups.Find(accepterGrp.shortname) == -1)
-			requesterGrp.allianceGroups.Insert(accepterGrp.shortname);
-
-		pendingRequests.RemoveItem(pending);
-
-		// Refresh the accepter's pending list (this request is now resolved)
-		SendPendingSyncToGroup(accepterGrp);
-
-		// Sync to both sides
-		SyncAllianceToGroup(accepterGrp);
-		SyncAllianceToGroup(requesterGrp);
-
-		// Notify both
-		mgr.SendInfoNotification(sender, "Альянс з [" + requesterShortname + "] укладено!");
-		NotifyGroupLeader(requesterGrp, "Група [" + accepterGrp.shortname + "] прийняла ваш запит на альянс!");
-		OBLLogger.Debug("Alliance Accepted: " + accepterGrp.shortname + " <-> " + requesterShortname);
-	}
-
-	// Leader of declinerGrp declines request from requesterShortname
-	void HandleDecline(PlayerIdentity sender, OBLParty declinerGrp, string requesterShortname, OBLPartyManager mgr) {
-		PurgeExpiredRequests();
-		OBLAlliancePendingRequest pending = FindPending(requesterShortname, declinerGrp.shortname);
-		if (pending)
-			pendingRequests.RemoveItem(pending);
-
-		// Refresh the decliner's pending list
-		SendPendingSyncToGroup(declinerGrp);
-
-		mgr.SendInfoNotification(sender, "Запит на альянс від [" + requesterShortname + "] відхилено.");
-
-		OBLParty requesterGrp = mgr.GetGroupByShortName(requesterShortname);
-		if (requesterGrp)
-			NotifyGroupLeader(requesterGrp, "Група [" + declinerGrp.shortname + "] відхилила ваш запит на альянс.");
-		OBLLogger.Debug("Alliance Declined: " + declinerGrp.shortname + " declined " + requesterShortname);
-	}
-
-	// Leader of leaverGrp leaves alliance with targetShortname
-	void HandleLeave(PlayerIdentity sender, OBLParty leaverGrp, string targetShortname, OBLPartyManager mgr) {
-		if (!IsLeader(sender, leaverGrp)) {
-			mgr.SendErrorNotification(sender, "Тільки лідер може розірвати альянс!");
-			return;
-		}
-
-		OBLParty targetGrp = mgr.GetGroupByShortName(targetShortname);
-
-		// Remove allied member markers before clearing the alliance lists
-		if (targetGrp) {
-			SyncRemoveAlliedMembersFromGroup(leaverGrp, targetGrp);
-			SyncRemoveAlliedMembersFromGroup(targetGrp, leaverGrp);
-		}
-
-		leaverGrp.allianceGroups.RemoveItem(targetShortname);
-		if (targetGrp)
-			targetGrp.allianceGroups.RemoveItem(leaverGrp.shortname);
-
-		SyncAllianceToGroup(leaverGrp);
-		if (targetGrp)
-			SyncAllianceToGroup(targetGrp);
-
-		mgr.SendInfoNotification(sender, "Альянс з [" + targetShortname + "] розірвано.");
-		if (targetGrp)
-			NotifyGroupLeader(targetGrp, "Група [" + leaverGrp.shortname + "] розірвала альянс з вами.");
-		OBLLogger.Debug("Alliance Left: " + leaverGrp.shortname + " left " + targetShortname);
-	}
-
-	// Call this when a group is deleted to clean up alliances
-	void OnGroupDeleted(OBLParty deletedGrp, OBLPartyManager mgr) {
-		string tag = deletedGrp.shortname;
-
-		// Remove from all allied groups
-		foreach (string alliedTag : deletedGrp.allianceGroups) {
-			OBLParty allied = mgr.GetGroupByShortName(alliedTag);
-			if (allied) {
-				SyncRemoveAlliedMembersFromGroup(allied, deletedGrp);
-				allied.allianceGroups.RemoveItem(tag);
-				SyncAllianceToGroup(allied);
-			}
-		}
-
-		// Remove pending requests involving this group
-		for (int i = pendingRequests.Count() - 1; i >= 0; i--) {
-			OBLAlliancePendingRequest req = pendingRequests.Get(i);
-			if (req.requesterShortname == tag || req.targetShortname == tag)
-				pendingRequests.Remove(i);
-		}
-	}
-
-	// ---- Private helpers ----
-
-	private bool IsLeader(PlayerIdentity sender, OBLParty grp) {
-		OBLPartyMember member = grp.GetMemberBySteamid(sender.GetPlainId());
-		if (!member)
-			return false;
-		OBLPartyPermission perm = member.GetPermission();
-		return perm && perm.canInvite;
-	}
-
-	private void NotifyGroupLeader(OBLParty grp, string message) {
-		foreach (OBLPartyMember member : grp.members) {
-			if (!member)
-				continue;
-			OBLPartyPermission perm = member.GetPermission();
-			if (perm && perm.canInvite) {
-				PlayerBase pb = OBLParty.GetPlayerBySteamid(member.steamid);
-				if (pb && pb.GetIdentity()) {
-					// reuse game notification channel
-					GetGame().RPCSingleParam(pb, OBLPartyRPCs.OBL_GLOBAL_CHAT,
-						new Param1<string>("[Alliance] " + message), true, pb.GetIdentity());
-				}
-			}
-		}
-	}
-}
