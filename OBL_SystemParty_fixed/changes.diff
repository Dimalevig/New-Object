+			return false;
+		if (!ctx.Read(globalChannel))
+			return false;
+		if (!ctx.Read(groupChannel))
+			return false;
+		if (!ctx.Read(directChannel))
+			return false;
+		if (!ctx.Read(defaultChannel))
+			return false;
+		return true;
+	}
+}
